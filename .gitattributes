# Normalize to LF in the repo and the working tree. These files are deployed to
# Linux hosting, so LF is the correct on-disk form; without this, Windows
# checkouts rewrite every file to CRLF and produce noisy whole-file diffs.
* text=auto eol=lf

# Binary — never touch line endings or try to diff these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.zip    binary
